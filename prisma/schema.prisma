generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SchoolSettings {
  id                String  @id @default(cuid())
  schoolName        String  @default("")
  logo              String? // base64 encoded logo (KOP surat / letterhead)
  appLogo           String? // base64 encoded application logo (login & sidebar)
  favicon           String? // base64 encoded favicon (browser tab icon)
  logoWidth         Float   @default(3.0) // in cm
  logoHeight        Float   @default(3.0) // in cm
  fontFamily        String  @default("Times New Roman")
  fontSize          Int     @default(14) // in pt
  isBold            Boolean @default(false)
  textTransform     String  @default("none") // none, uppercase, capitalize, lowercase
  underlineThickness Float  @default(1.0) // in px
  underlineWidth    Float   @default(100.0) // in percentage
  address           String?
  phone             String?
  email             String?
  npsn              String? // Nomor Pokok Sekolah Nasional
  schoolCode        String  @default("") // Kode sekolah untuk format nomor surat (misal: SMAN1TLD)
  letterUnitCode    String  @default("TU") // Kode unit untuk format nomor surat (misal: TU = Tata Usaha)
  kopLines          String  @default("[]") // JSON array of strings for KOP identity lines
  // Penandatangan laporan (disinkronisasi ke semua hasil cetak)
  principalName     String  @default("") // Nama Kepala Sekolah
  principalNip      String  @default("") // NIP Kepala Sekolah
  treasurerName     String  @default("") // Nama Bendahara
  treasurerNip      String  @default("") // NIP Bendahara
  goodsManagerName  String  @default("") // Nama Pengurus Barang (berbeda dari Bendahara)
  goodsManagerNip   String  @default("") // NIP Pengurus Barang
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Store {
  id          String   @id @default(cuid())
  name        String
  ownerName   String   @default("")
  npwp        String   @default("")
  goodsType   String   @default("") // Jenis barang yang dijual
  phone       String   @default("")
  address     String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders        Order[]
  barangMasuk   BarangMasuk[]
  galonEntries  GalonEntry[]
}

model Employee {
  id          String   @id @default(cuid())
  name        String
  nip         String   @default("") // Nomor Induk Pegawai
  position    String   @default("") // Jabatan
  department  String   @default("") // Unit kerja
  phone       String   @default("")
  address     String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders        Order[]
  barangMasuk   BarangMasuk[]
}

model Room {
  id          String   @id @default(cuid())
  name        String
  building    String   @default("")
  floor       String   @default("")
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  biliks      Bilik[]
  lemari      Lemari[]
  items       Item[]
}

model Bilik {
  id          String   @id @default(cuid())
  name        String
  number      String   @default("")
  description String   @default("")
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  items       Item[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lemari {
  id          String   @id @default(cuid())
  number      String
  description String   @default("")
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  items       Item[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Inventaris Models (completely independent from KIB) ────────────────────

model InventoryBuilding {
  id               String   @id @default(cuid())
  name             String
  code             String   @default("") // Kode gedung (misal: A, B, GED-A)
  floors           Int      @default(1) // Jumlah lantai
  description      String   @default("")
  // ── Aset fields ──
  condition        String   @default("Baik") // Keadaan: Baik, Rusak Ringan, Rusak Berat
  acquisitionYear  Int?     // Tahun perolehan / dibangun
  acquisitionPrice Float    @default(0) // Nilai perolehan aset
  sumberDana       String   @default("") // Sumber dana pengadaan
  // ── Dimensi fisik ──
  length           Float    @default(0) // Panjang (m)
  width            Float    @default(0) // Lebar (m)
  height           Float    @default(0) // Tinggi (m)
  area             Float    @default(0) // Luas bangunan (m²)
  volume           Float    @default(0) // Volume (m³)
  landArea         Float    @default(0) // Luas tanah (m²)
  // ── Metadata aset ──
  registrationNumber String @default("") // Nomor Registrasi / Kode Aset BMD
  documentNumber   String   @default("") // No. Dokumen Perolehan (kontrak/STN)
  responsiblePerson String  @default("") // Penanggung Jawab
  usefulLife       Int?     // Masa Manfaat (tahun)
  notes            String   @default("") // Catatan tambahan
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  rooms            InventoryRoom[]
}

model InventoryRoom {
  id               String   @id @default(cuid())
  name             String
  buildingId       String?
  building         InventoryBuilding? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  floor            String   @default("")
  description      String   @default("")
  // ── Aset fields ──
  condition        String   @default("Baik") // Keadaan: Baik, Rusak Ringan, Rusak Berat
  acquisitionYear  Int?     // Tahun perolehan
  acquisitionPrice Float    @default(0) // Nilai perolehan aset
  sumberDana       String   @default("") // Sumber dana pengadaan
  // ── Dimensi fisik ──
  length           Float    @default(0) // Panjang (m)
  width            Float    @default(0) // Lebar (m)
  height           Float    @default(0) // Tinggi (m)
  area             Float    @default(0) // Luas ruangan (m²)
  volume           Float    @default(0) // Volume (m³)
  capacity         Int      @default(0) // Kapasitas (jumlah orang)
  // ── Metadata aset ──
  registrationNumber String @default("") // Nomor Registrasi / Kode Aset
  documentNumber   String   @default("") // No. Dokumen Perolehan
  responsiblePerson String  @default("") // Penanggung Jawab
  usefulLife       Int?     // Masa Manfaat (tahun)
  notes            String   @default("") // Catatan tambahan
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  biliks           InventoryBilik[]
  cabinets         InventoryCabinet[]
  items            InventoryItem[]
}

model InventoryBilik {
  id               String   @id @default(cuid())
  name             String
  number           String   @default("")
  description      String   @default("")
  roomId           String
  room             InventoryRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  // ── Aset fields ──
  condition        String   @default("Baik") // Keadaan: Baik, Rusak Ringan, Rusak Berat
  acquisitionYear  Int?     // Tahun perolehan
  acquisitionPrice Float    @default(0) // Nilai perolehan aset
  sumberDana       String   @default("") // Sumber dana pengadaan
  // ── Dimensi fisik ──
  length           Float    @default(0) // Panjang (m)
  width            Float    @default(0) // Lebar (m)
  height           Float    @default(0) // Tinggi (m)
  area             Float    @default(0) // Luas (m²)
  volume           Float    @default(0) // Volume (m³)
  // ── Metadata aset ──
  registrationNumber String @default("") // Nomor Registrasi / Kode Aset
  documentNumber   String   @default("") // No. Dokumen Perolehan
  responsiblePerson String  @default("") // Penanggung Jawab
  usefulLife       Int?     // Masa Manfaat (tahun)
  notes            String   @default("") // Catatan tambahan
  items            InventoryItem[]
  cabinets         InventoryCabinet[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model InventoryCabinet {
  id               String   @id @default(cuid())
  number           String
  description      String   @default("")
  roomId           String
  room             InventoryRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bilikId          String?
  bilik            InventoryBilik? @relation(fields: [bilikId], references: [id], onDelete: SetNull)
  // ── Aset fields ──
  condition        String   @default("Baik") // Keadaan: Baik, Rusak Ringan, Rusak Berat
  acquisitionYear  Int?     // Tahun perolehan
  acquisitionPrice Float    @default(0) // Nilai perolehan aset
  sumberDana       String   @default("") // Sumber dana pengadaan
  // ── Dimensi fisik ──
  length           Float    @default(0) // Panjang (m)
  width            Float    @default(0) // Lebar (m)
  height           Float    @default(0) // Tinggi (m)
  area             Float    @default(0) // Luas alas (m²)
  volume           Float    @default(0) // Volume (m³)
  // ── Metadata aset ──
  registrationNumber String @default("") // Nomor Registrasi / Kode Aset
  documentNumber   String   @default("") // No. Dokumen Perolehan
  responsiblePerson String  @default("") // Penanggung Jawab
  usefulLife       Int?     // Masa Manfaat (tahun)
  notes            String   @default("") // Catatan tambahan
  items            InventoryItem[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model InventoryItem {
  id                String   @id @default(cuid())
  name              String
  registrationNumber String  @default("") // Nomor Register
  brand             String   @default("") // Merk
  condition         String   @default("Baik") // Kondisi (Baik, Rusak Ringan, Rusak Berat)
  quantity          Int      @default(1)
  unit              String   @default("Unit")
  price             Float    @default(0)
  sumberDana        String   @default("") // Sumber Dana (APBN, APBD, BOS, Donasi, dll)
  tahunPengadaan    Int?     // Tahun Pengadaan
  notes             String   @default("")
  // Location fields
  roomId            String?
  room              InventoryRoom?    @relation(fields: [roomId], references: [id])
  bilikId           String?
  bilik             InventoryBilik?   @relation(fields: [bilikId], references: [id])
  cabinetId         String?
  cabinet           InventoryCabinet? @relation(fields: [cabinetId], references: [id])
  // Photos
  photos            String   @default("[]") // JSON array of photo filenames
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Item {
  id                String   @id @default(cuid())
  name              String
  kibType           String   @default("B") // A, B, C, D, E, F
  registrationNumber String  @default("") // Nomor Register
  brand             String   @default("") // Merk
  model             String   @default("") // Model
  serialNumber      String   @default("") // No. Seri Pabrik
  material          String   @default("") // Bahan
  yearMade          Int?     // Tahun pembuatan
  size              String   @default("") // Ukuran
  condition         String   @default("Baik") // Kondisi (Baik, Rusak Ringan, Rusak Berat)
  quantity          Int      @default(1)
  unit              String   @default("Unit")
  origin            String   @default("") // Asal usul
  sumberDana        String   @default("") // Sumber Dana (APBN, APBD, BOS, Donasi, dll)
  price             Float    @default(0)
  acquisitionYear   Int?     // Tahun pengadaan
  notes             String   @default("")
  // Location fields
  roomId            String?
  room              Room?    @relation(fields: [roomId], references: [id])
  bilikId           String?
  bilik             Bilik?   @relation(fields: [bilikId], references: [id])
  lemariId          String?
  lemari           Lemari?  @relation(fields: [lemariId], references: [id])
  // KIB A specific (Tanah)
  landCertificate   String   @default("") // Sertifikat
  landArea          Float    @default(0) // Luas tanah (m2)
  landStatus        String   @default("") // Status tanah
  landUsage         String   @default("") // Penggunaan tanah
  // KIB C specific (Gedung & Bangunan)
  buildingLevel     String   @default("") // Tingkat
  buildingConcrete  String   @default("") // Beton
  buildingArea      Float    @default(0) // Luas (m2)
  buildingLocation  String   @default("") // Letak
  // KIB D specific (Jalan, Irigasi, Jaringan)
  roadLength        Float    @default(0) // Panjang (km)
  roadWidth         Float    @default(0) // Lebar (m)
  roadArea          Float    @default(0) // Luas (m2)
  roadLocation      String   @default("") // Letak
  // KIB F specific (Konstruksi Dalam Pengerjaan)
  contractNumber    String   @default("") // Nomor Kontrak
  implementationYear Int?    // Tahun pelaksanaan
  // Photos
  photos            String   @default("[]") // JSON array of photo filenames
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   // Nomor Surat Pesanan
  orderDate       DateTime @default(now())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id])
  employeeId      String?  // Pegawai yang memesan
  employee        Employee? @relation(fields: [employeeId], references: [id])
  status          String   @default("Draft") // Draft, Dikirim, Diterima, Selesai
  paymentMethod   String   @default("Cash") // Cash, BON
  paymentStatus   String   @default("LUNAS") // LUNAS, BELUM_BAYAR
  paidAt          DateTime? // Tanggal pelunasan BON
  notes           String   @default("")
  totalAmount     Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  items           OrderItem[]
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemName    String
  quantity    Int      @default(1)
  unit        String   @default("Unit")
  unitPrice   Float    @default(0)
  totalPrice  Float    @default(0)
  notes       String   @default("")
  // ── Foto barang (bukti/foto pesanan) ──
  // Disimpan sebagai JSON array berisi base64 data URL.
  // Base64 dipakai supaya tidak perlu endpoint upload terpisah dan tetap
  // bekerja di Vercel (filesystem read-only). Ukuran dikompres client-side
  // (max ~1024px, JPEG 0.85) sehingga setiap foto ~100-300KB.
  photos      String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BarangMasuk {
  id              String            @id @default(cuid())
  documentNumber  String            // Nomor dokumen barang masuk
  entryDate       DateTime          @default(now()) // Tanggal masuk
  storeId         String?           // Toko asal (opsional)
  store           Store?            @relation(fields: [storeId], references: [id])
  employeeId      String?           // Pegawai penerima
  employee        Employee?         @relation(fields: [employeeId], references: [id])
  source          String            @default("") // Sumber barang (donasi, pembelian, dll)
  notes           String            @default("")
  status          String            @default("Draft") // Draft, Diterima, Ditolak
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  items           BarangMasukItem[]
}

model BarangMasukItem {
  id            String   @id @default(cuid())
  barangMasukId String
  barangMasuk   BarangMasuk @relation(fields: [barangMasukId], references: [id], onDelete: Cascade)
  itemName      String   // Nama barang
  quantity      Int      @default(1)
  unit          String   @default("Unit")
  condition     String   @default("Baik") // Kondisi (Baik, Rusak Ringan, Rusak Berat)
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  name      String   // Nama lengkap
  username  String   @unique // Username untuk login
  password  String   // Password (disimpan sebagai plaintext agar admin bisa melihat)
  role      String   @default("staff") // admin, staff
  active    Boolean  @default(true) // Status aktif
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Master Options (reusable dropdown values with add-new capability) ──────
// Stores reusable option values per category so users can pick from a list
// AND add new ones inline. Categories include:
//   satuan, sumberDana, merk, bahan, asalUsul, sumberBarang,
//   jabatan, unitKerja, jenisBarang
model MasterOption {
  id        String   @id @default(cuid())
  category  String   // e.g. "satuan", "sumberDana"
  value     String   // the actual option text, e.g. "Pcs", "APBN"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, value])
  @@index([category])
}

// ─── Gaji (Salary) — Data Guru / Honor Mengajar ───────────────────────────────
// Catatan: kolom `status` & `jabatan` dipakai sebagai pembeda kategori pegawai
// (mis. GTTS / PTTS) — TIDAK ditampilkan di format cetak gaji, hanya di tabel &
// form. Format cetak gaji sudah final, jangan diubah.
model SalaryEntry {
  id              String   @id @default(cuid())
  name            String   // Nama guru
  nip             String   @default("") // NIP
  bankAccount     String   @default("") // No. Rekening Tabungan (untuk kolom cetak gaji)
  gender          String   @default("L") // Jenis Kelamin: L / P
  // ── Pembeda kategori pegawai (TIDAK masuk format cetak) ──
  status          String   @default("") // STATUS pegawai: GTTS, PTTS, PNS, PPPK, Honorer, dll.
  jabatan         String   @default("") // JABATAN: GURU SEMENTARA, HONORER SEKOLAH, PEGAWAI SEKOLAH, dll.
  // ── Perhitungan honor ──
  lessonCount     Int      @default(0) // Jumlah Les (default per bulan)
  unit            String   @default("Jam") // Satuan (dropdown, bisa ditambah)
  pricePerLesson  Float    @default(0) // Harga Per Les
  totalReceived   Float    @default(0) // Penerimaan (total = lessonCount × pricePerLesson)
  period          String   @default("") // Periode (mis. "Januari 2026")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  payments        SalaryPayment[]
}

// ─── Media — Database Langganan Media ─────────────────────────────────────────
model MediaEntry {
  id              String   @id @default(cuid())
  name            String   // Nama (pelanggan/penanggung jawab)
  mediaName       String   // Nama Media (koran/majalah)
  paymentType     String   @default("Tunai") // Pembayaran: Tunai / Transfer
  pricePerMonth   Float    @default(0) // Harga Perbulan
  unitCount       Int      @default(1) // Satuan (jumlah bulan langganan: 1/2/3/.../12)
  totalReceived   Float    @default(0) // Penerimaan (total = unitCount × pricePerMonth)
  period          String   @default("") // Periode
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  payments        MediaPayment[]
}

// ─── Catatan Pembayaran per Bulan (Media) ─────────────────────────────────────
// Melacak bulan mana saja yang sudah dibayar / belum dibayar untuk tiap media.
// Satu baris = pembayaran untuk satu bulan (year + month) dari satu media.
model MediaPayment {
  id          String    @id @default(cuid())
  mediaId     String
  media       MediaEntry @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  year        Int       // Tahun, mis. 2026
  month       Int       // 1-12 (Januari-Desember)
  amount      Float     @default(0) // Jumlah dibayar untuk bulan ini
  notes       String    @default("") // Catatan tambahan
  paidAt      DateTime  @default(now()) // Tanggal pembayaran
  // ── Foto bukti pembayaran (base64 data URLs, JSON array) ──
  proofPhotos String    @default("[]") // Foto bukti setelah TTD penerima
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([mediaId, year, month])
  @@index([mediaId])
}

// ─── Catatan Pembayaran per Bulan (Gaji) ──────────────────────────────────────
// Melacak bulan mana saja yang sudah dibayar / belum dibayar untuk tiap guru.
model SalaryPayment {
  id                String    @id @default(cuid())
  salaryId          String
  salary            SalaryEntry @relation(fields: [salaryId], references: [id], onDelete: Cascade)
  year              Int       // Tahun
  month             Int       // 1-12
  lessonCount       Int       @default(0) // Jumlah les di bulan ini (override default)
  amount            Float     @default(0) // Jumlah dibayar untuk bulan ini
  notes             String    @default("") // Catatan tambahan
  paidAt            DateTime  @default(now()) // Tanggal pembayaran (legacy, saat record dibuat)
  // ── Tracking cetak per mode (auto-record setelah kedua laporan terbit) ──
  signaturePrinted  Boolean   @default(false) // true = sudah cetak mode Tanda Tangan Guru
  bankPrinted       Boolean   @default(false) // true = sudah cetak mode Bank
  fullyPaidAt       DateTime? // null = belum lengkap; ter-set saat kedua mode tercetak
  // ── Foto bukti pembayaran (base64 data URLs, JSON array) ──
  proofPhotos       String    @default("[]") // Foto bukti setelah TTD penerima
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([salaryId, year, month])
  @@index([salaryId])
}

// ─── Galon — Catatan Penerimaan & Pembayaran Galon ────────────────────────────
// Melacak galon masuk (kosong & isi) dari toko, dengan status pembayaran
// (Cash / Bon) & tanggal pelunasan. Berguna untuk SPJ galon kantor.
model GalonEntry {
  id              String    @id @default(cuid())
  // Kuantitas galon
  emptyCount      Int       @default(0) // 1. Galon kosong
  filledCount     Int       @default(0) // 2. Galon di isi
  // Toko asal galon
  storeId         String? // 3. Toko (relasi opsional ke Store)
  store           Store?    @relation(fields: [storeId], references: [id], onDelete: SetNull)
  storeName       String    @default("") // Snapshot nama toko (untuk tampilan cetak)
  // Identitas
  courier         String    @default("") // 4. Pengantar / Penandatangan
  recipient       String    @default("") // 5. Penerima (nama media/penerima)
  receivedDate    DateTime  @default(now()) // 6. Tanggal terima
  // Status pembayaran
  paymentMethod   String    @default("Cash") // 7. Cash atau Bon
  paymentStatus   String    @default("LUNAS") // LUNAS / BELUM_BAYAR (auto dari method)
  paidAt          DateTime? // 8. Tanggal bayar (null jika Cash = tanggal terima, Bon = tanggal lunas)
  notes           String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
